---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// The site runs light-only (ui.theme: light:only), so there is no dark variant.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    /* Pawreli brand palette */
    --brand-teal: #2e9e96;
    --brand-teal-dark: #1b6560;
    --brand-peach: #e0a87c;
    --brand-peach-dark: #c4854f;
    --ink: #15302a;
    --ink-muted: #4a6b63;
    --cream: #fbf5ec;
    --mint: #e8f4f1;

    --aw-color-primary: var(--brand-teal);
    --aw-color-secondary: var(--brand-teal-dark);
    --aw-color-accent: var(--brand-peach);
    --aw-color-link: var(--brand-teal-dark);

    --aw-color-text-heading: var(--ink);
    --aw-color-text-default: var(--ink);
    --aw-color-text-muted: var(--ink-muted);
    --aw-color-bg-page: var(--cream);

    ::selection {
      background-color: var(--mint);
    }
  }
</style>
