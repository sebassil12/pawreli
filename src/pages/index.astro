---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { PRECIOS, whatsappLink } from '~/config/contacto';

const metadata = {
  title: 'Pawreli — Placas QR para mascotas en Cuenca',
  ignoreTitleTemplate: true,
};

// The WhatsApp button is the only call to action on the page. Each section
// sends a different preset message so we know which product raised interest.
const heroWhatsapp = whatsappLink('¡Hola Pawreli! Quiero una placa QR para mi mascota 🐾');
const placaWhatsapp = whatsappLink(`¡Hola Pawreli! Me interesa la Placa QR personalizada ($${PRECIOS.placa}) 🐾`);
const kitWhatsapp = whatsappLink(`¡Hola Pawreli! Me interesa el Kit de Bienvenida ($${PRECIOS.kit}) 🐾`);
const cierreWhatsapp = whatsappLink('¡Hola Pawreli! Quiero pedir mi placa 🐾');
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    tagline="Cuenca, Ecuador"
    actions={[
      {
        variant: 'primary',
        text: 'Escríbenos por WhatsApp',
        href: heroWhatsapp,
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
    image="<img src='/placa.svg' alt='Placa QR Pawreli' class='mx-auto w-full max-w-md rounded-md' width='1024' height='576' />"
  >
    <Fragment slot="title">Si se pierde, que sepan cómo volver a casa</Fragment>
    <Fragment slot="subtitle">
      Una placa con código QR para tu perro o gato. Quien lo encuentre escanea la placa, ve su perfil y te avisa al
      instante por WhatsApp.
    </Fragment>
  </Hero>

  <!-- Cómo funciona -->
  <Steps
    id="como-funciona"
    title="Cómo funciona"
    items={[
      {
        title: 'Escanea la placa',
        description: 'Quien encuentra a tu mascota apunta la cámara al código QR grabado en la placa.',
        icon: 'tabler:qrcode',
      },
      {
        title: 'Se abre el perfil',
        description: 'Ve la foto y el nombre de tu mascota, sin instalar nada ni crear cuentas.',
        icon: 'tabler:paw',
      },
      {
        title: 'Te avisa por WhatsApp',
        description: 'Con un toque te escribe por WhatsApp o te llama. Vuelves a estar en contacto en segundos.',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  />

  <!-- Precios -->
  <Pricing
    id="precios"
    title="Precios"
    subtitle="Pago único, sin suscripciones."
    prices={[
      {
        title: 'Placa QR',
        subtitle: 'Personalizada para tu mascota',
        price: PRECIOS.placa,
        period: 'pago único',
        items: [
          { description: 'Código QR grabado, resistente' },
          { description: 'Perfil web con foto y nombre' },
          { description: 'Aviso al tutor por WhatsApp' },
        ],
        callToAction: {
          text: 'Pedir por WhatsApp',
          href: placaWhatsapp,
          target: '_blank',
          icon: 'tabler:brand-whatsapp',
        },
      },
      {
        title: 'Kit de Bienvenida',
        subtitle: 'El regalo completo',
        price: PRECIOS.kit,
        period: 'pago único',
        hasRibbon: true,
        ribbonTitle: 'Regalo',
        highlight: true,
        items: [
          { description: 'Placa QR personalizada' },
          { description: 'Bandana' },
          { description: 'Juguete' },
          { description: 'Caja de regalo' },
        ],
        callToAction: {
          text: 'Pedir por WhatsApp',
          href: kitWhatsapp,
          target: '_blank',
          icon: 'tabler:brand-whatsapp',
        },
      },
    ]}
  />

  <!-- Cierre -->
  <CallToAction
    id="cierre"
    layout="banner"
    actions={[
      {
        variant: 'primary',
        text: 'Escríbenos por WhatsApp',
        href: cierreWhatsapp,
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">Dale a tu mascota una forma de volver</Fragment>
    <Fragment slot="subtitle">Escríbenos y coordinamos tu placa. Estamos en Cuenca.</Fragment>
  </CallToAction>
</Layout>
