---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import PetLayout from '~/layouts/PetLayout.astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const pets = await getCollection('pets');
  return pets.map((pet) => ({
    params: { slug: pet.id },
    props: { pet },
  }));
}) satisfies GetStaticPaths;

const { pet } = Astro.props;
const { nombre, raza, foto, tutor, whatsapp, nota } = pet.data;

// The engraved tag code is the filename token, uppercased and split: a7k9x2m4 -> A7K9-X2M4.
const codigo = `${pet.id.slice(0, 4)}-${pet.id.slice(4)}`.toUpperCase();

const mensaje = encodeURIComponent(`¡Hola! Encontré a ${nombre} 🐾`);
const whatsappHref = `https://wa.me/${whatsapp}?text=${mensaje}`;
const telHref = `tel:+${whatsapp}`;
---

<PetLayout title={`¿Encontraste a ${nombre}?`}>
  <style is:inline>
    .titulo {
      font-size: 30px;
      font-weight: 800;
      text-align: center;
      margin-bottom: 16px;
      color: #15302a;
    }
    .foto {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 16px;
      background: #e8f4f1;
      margin-bottom: 16px;
    }
    .nombre {
      font-size: 26px;
      font-weight: 700;
      text-align: center;
      color: #15302a;
    }
    .raza {
      font-size: 18px;
      text-align: center;
      color: #4a6b63;
      margin-bottom: 24px;
    }
    .whatsapp {
      display: block;
      width: 100%;
      min-height: 64px;
      padding: 18px 20px;
      background: #1b6560;
      color: #fff;
      font-size: 21px;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
      border-radius: 14px;
    }
    .tel {
      display: block;
      width: 100%;
      min-height: 56px;
      padding: 16px;
      margin-top: 12px;
      font-size: 18px;
      font-weight: 600;
      text-align: center;
      color: #1b6560;
      text-decoration: underline;
    }
    .nota {
      margin-top: 24px;
      padding: 16px;
      background: #e8f4f1;
      border-radius: 12px;
      font-size: 17px;
      color: #15302a;
    }
    .nota strong {
      display: block;
      margin-bottom: 4px;
      color: #4a6b63;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .codigo {
      margin-top: 28px;
      text-align: center;
      font-size: 13px;
      color: #4a6b63;
    }
    .codigo span {
      font-weight: 700;
      letter-spacing: 0.08em;
    }
    .pie {
      margin-top: 24px;
      text-align: center;
      font-size: 13px;
    }
    .pie a {
      color: #4a6b63;
      text-decoration: none;
    }
  </style>

  <h1 class="titulo">¿Encontraste a {nombre}?</h1>

  <img class="foto" src={foto} alt={`Foto de ${nombre}`} width="420" height="315" decoding="async" />

  <p class="nombre">{nombre}</p>
  <p class="raza">{raza}</p>

  <a class="whatsapp" href={whatsappHref}>Avisar a {tutor} por WhatsApp</a>
  <a class="tel" href={telHref}>o llamar por teléfono</a>

  {
    nota && (
      <div class="nota">
        <strong>Nota</strong>
        {nota}
      </div>
    )
  }

  <p class="codigo">Código de placa: <span>{codigo}</span></p>

  <p class="pie"><a href="/">Placa Pawreli</a></p>
</PetLayout>
