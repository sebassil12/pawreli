---
// Standalone layout for the public pet profile. Deliberately does NOT use the
// site layouts: those pull in header, nav, theme toggle and scroll animations
// this page can't afford. The reader is a stranger on a cheap Android, on bad
// 3G, in the street. Zero JS, zero off-domain requests, high contrast.
// Base styles only; the profile component styles live in the page.
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:inline>
      :root {
        --ink: #15302a;
        --ink-muted: #4a6b63;
        --teal: #1b6560;
        --peach: #c4854f;
        --line: #dce6e3;
        box-sizing: border-box;
        padding-top: env(safe-area-inset-top, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }
      body {
        margin: 0;
        background: #fff;
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        -webkit-text-size-adjust: 100%;
      }
      .wrap {
        max-width: 430px;
        margin: 0 auto;
        padding: 20px 18px 40px;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <slot />
    </div>
  </body>
</html>
